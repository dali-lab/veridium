  questionText:
  - language: English
    text: Which four main groups does every amino acid have?
  - language: German
    text: "Welche vier Hauptgruppen besitzt jede Aminos\xE4ure?"
  answers:
  - texts:
    - language: English
      text: Hydroxyl group, methyl group, carboxyl group, side chain
    - language: German
      text: Hydroxylgruppe, Methylgruppe, Carboxylgruppe, Seitenkette
  - texts:
    - language: English
      text: Amino group, carboxyl group, hydrogen atom, side chain (R group)
    - language: German
      text: Aminogruppe, Carboxylgruppe, Wasserstoffatom, Seitenkette (R-Rest)
  - texts:
    - language: English
      text: Ester group, carboxyl group, hydrogen atom, phosphate group
    - language: German
      text: Estergruppe, Carboxylgruppe, Wasserstoffatom, Phosphatgruppe
  - texts:
    - language: English
      text: Amino group, aldehyde group, carboxyl group, ribonucleotide
    - language: German
      text: Aminogruppe, Aldehydgruppe, Carboxylgruppe, Ribonukleotid
  correctAnswer: 2
